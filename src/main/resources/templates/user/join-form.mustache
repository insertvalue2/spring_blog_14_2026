{{> layout/header}}

<div class="container p-5">

    <!-- 
        ⭐ 파일 업로드를 위한 form 태그 설정
        - method="post": 파일은 POST 방식으로만 전송 가능
        - enctype="multipart/form-data": 파일을 포함한 데이터 전송 시 필수!
          → 이 속성이 없으면 파일이 서버로 전송되지 않음
          → 일반 텍스트 데이터는 "application/x-www-form-urlencoded" (기본값)
          → 파일 데이터는 "multipart/form-data" 필요
    -->

    <div class="card">
        <div class="card-header"><b>회원가입을 해주세요</b></div>
        <div class="card-body">
            <form action="/join" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Enter username" name="username">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="Enter password" name="password">
                </div>
                <div class="mb-3">
                    <input type="email" class="form-control" placeholder="Enter email" name="email">
                </div>
                <!-- 
                    ⭐ 프로필 이미지 업로드 (선택사항)
                    - type="file": 파일 선택 입력 필드
                    - name="profileImage": 서버에서 받을 때 사용하는 파라미터명
                      → Controller의 @PostMapping("/join") 메서드에서
                      → UserRequest.JoinDTO의 profileImage 필드로 자동 바인딩됨
                    - accept="image/*": 파일 선택 대화상자에서 이미지 파일만 보이도록 필터링
                      → 사용자 편의성 향상 (하지만 서버에서도 반드시 검증 필요!)
                    
                    ⚠️ 주의: accept 속성만으로는 보안이 보장되지 않음
                    → 서버(UserService)에서 FileUtil.isImageFile()로 반드시 재검증!
                -->
                <div class="mb-3">
                    <label for="profileImage" class="form-label">프로필 사진 (선택사항)</label>
                    <input type="file" class="form-control" id="profileImage" name="profileImage" accept="image/*">
                    <small class="form-text text-muted">이미지 파일만 업로드 가능합니다 (JPG, PNG, GIF 등)</small>
                    <small class="form-text text-muted d-block mt-1">💡 프로필 사진을 등록하지 않아도 회원가입이 가능합니다.</small>
                </div>
                <button type="submit" class="btn btn-primary form-control">회원가입</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}
